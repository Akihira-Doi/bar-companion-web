# Copy this file to .env and replace both values.
# Never commit the real .env file.
APP_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
SESSION_HOURS=8
ADMIN_PIN=replace-with-a-4-digit-admin-pin
CUSTOMER_DATA_PATH=data/customers.local.json

# OpenAI API settings. Keep the real key only in .env.
OPENAI_API_KEY=sk-proj-replace-with-your-project-key
OPENAI_REPLY_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Leave both values unset to continue using HTTP.
# Local certificate and key files must never be committed.
HTTPS_CERT_PATH=certs/lan-cert.pem
HTTPS_KEY_PATH=certs/lan-key.pem
